# Copia este archivo a ".env" en esta misma carpeta (backend/) y completa los valores.
# ".env" no se sube a git.

# 'mock' usa las carpetas de ejemplo en backend/mock-sgd/<cedula>/
# 'graph' conecta con la biblioteca real de SharePoint (SGD GRUPO SG)
DOC_PROVIDER=mock

MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SITE_HOSTNAME=
MS_SITE_PATH=
MS_LIBRARY_NAME=Documentos
MS_BASE_FOLDER_PATH=01.CROMA_MEDICAL/B_LINEAS_DE_NEGOCIO/14_Croma_Medical-IPS

# Opcional: cambia el usuario/clave del administrador que se crea automáticamente
# la primera vez que arranca el backend (solo aplica si todavía no existe un admin).
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=CromaAdmin2026!

# Opcional: firma de los tokens de sesión. Cambia esto por una cadena larga y aleatoria.
JWT_SECRET=croma-dev-secret-change-in-production
